# Core runtime
EDGE_STATE_DIR=/tmp/edge-runtime
# Per-process logs. Relative to the repo root. Optional, defaults to ./logs.
EDGE_LOG_DIR=./logs
EDGE_WORKER_COUNT=4
EDGE_MODEL_PATH=./backend/models/Phi-3-mini-4k-instruct-q4.gguf
EDGE_FORCE_CPU=0
EDGE_LOG_LEVEL=info

# Ports
EDGE_API_PORT=11434
EDGE_SHELL_PORT=3000
EDGE_STATUS_DASHBOARD_PORT=3001
EDGE_CHAT_ALL_PORT=5000
EDGE_CHAT_1_PORT=5001
EDGE_CHAT_2_PORT=5002
EDGE_CHAT_3_PORT=5003
EDGE_CHAT_4_PORT=5004
EDGE_CHAT_5_PORT=5005

# Public/internal service URLs
EDGE_API_BASE=http://127.0.0.1:11434
EDGE_SHELL_PUBLIC_BASE=http://127.0.0.1:3000

EDGE_ALLOWED_MFE_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5001,http://localhost:5001,http://127.0.0.1:5002,http://localhost:5002,http://127.0.0.1:5003,http://localhost:5003,http://127.0.0.1:5004,http://localhost:5004,http://127.0.0.1:5005,http://localhost:5005,http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5181,http://localhost:5181,http://127.0.0.1:5182,http://localhost:5182,http://127.0.0.1:5183,http://localhost:5183,http://127.0.0.1:5184,http://localhost:5184,http://127.0.0.1:5185,http://localhost:5185

# Inference defaults
EDGE_MAX_TOKENS=512
EDGE_TEMPERATURE=0.8
EDGE_GPU_LAYERS=99
EDGE_SEED=42

# Scheduler limits
EDGE_MAX_SLOTS=4
EDGE_MAX_PER_MFE=2
EDGE_MAX_QUEUE=20
EDGE_AGING_MS=15000
EDGE_QUEUE_TIMEOUT_MS=30000
EDGE_DEFAULT_JOB_MS=8000

# IPC and runtime files
EDGE_SHM_NAME=/edge-model-weights
EDGE_SUPERVISOR_SOCK=/tmp/edge-supervisor.sock
EDGE_WORKER_SOCKET_PREFIX=/tmp/edge-worker-
EDGE_WORKER_CONNECT_TIMEOUT_MS=3000
EDGE_API_NOTIFY_SOCK=/tmp/edge-api-notify.sock
EDGE_CRASH_LOG=./logs/edge-crash.log
EDGE_MODEL_CONFIG_PATH=/tmp/edge-model-config.json

# Execution bounds (a running job, not just a queued one)
EDGE_EXEC_TIMEOUT_MS=120000
EDGE_DONE_TTL_MS=300000
EDGE_DONE_MAX_ENTRIES=500

# Worker recovery after a crash. A worker whose socket has not appeared within the grace is
# treated as crashed rather than still starting.
EDGE_WORKER_RECOVERY_MS=2000
EDGE_WORKER_RECOVERY_ATTEMPTS=10
EDGE_WORKER_STARTUP_GRACE_MS=15000

# Replay safety
EDGE_IDEMPOTENCY_TTL_MS=300000
EDGE_INFLIGHT_PATH=/tmp/edge-inflight.json

# Client retry policy
EDGE_CLIENT_RETRY_ATTEMPTS=3
EDGE_CLIENT_RETRY_BASE_MS=500
EDGE_CLIENT_RETRY_MAX_MS=8000

# Worker-pool sizing. Per-worker budgets for context, KV and compute, not model
# size, and not EDGE_MAX_SLOTS. All optional; the values below are the defaults.
EDGE_GPU_RESERVE_MB=512
EDGE_WORKER_GPU_MB=2048
EDGE_RAM_RESERVE_MB=1024
EDGE_WORKER_RAM_MB=1024
EDGE_HW_PROBE_TIMEOUT_MS=10000

# GPU to CPU fallback: reexec respawns the worker, the only way to release the
# CUDA context. reload is faster but leaves it resident.
EDGE_DEVICE_FALLBACK_MODE=reexec

# Device fallback ladder. Comma-separated, highest tier first. Valid tiers:
# cpu cuda rocm vulkan npu directml gpu ane metal accelerate remote.
EDGE_DEVICE_LADDER=cuda,npu,ane,cpu,remote
EDGE_DEVICE_QUARANTINE_MS=60000
EDGE_DEVICE_PROBE_INTERVAL_MS=5000

# The remote tier needs both a key (or endpoint) and EDGE_REMOTE_FALLBACK_ALLOWED=1;
# a key alone is not consent. Leave the key empty here, put the real one in .env.
EDGE_SARVAM_API_KEY=
EDGE_REMOTE_FALLBACK_ALLOWED=0
# Optional base URL override. Empty means the SDK's own https://api.sarvam.ai.
EDGE_REMOTE_ENDPOINT=

# Transport script path is relative to the repo root.
EDGE_NODE_BIN=node
EDGE_REMOTE_TRANSPORT_SCRIPT=./backend/remote/sarvamTransport.js
EDGE_REMOTE_TIMEOUT_MS=30000
EDGE_SARVAM_MODEL=sarvam-105b-conversations
EDGE_SARVAM_TEMPERATURE=0.2
EDGE_SARVAM_TOP_P=1
EDGE_SARVAM_MAX_TOKENS=2000

# Exercises the fallback path without the hardware: [<tier>:]removed | unsupported | runtime.
# Injected once per worker, and only on the named tier. Empty means no injection.
EDGE_SIMULATE_DEVICE_FAULT=
