# Build outputs
/build/
**/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
.cache

# Dependencies
node_modules/

# Python virtualenv/cache
venv/
.venv/
__pycache__/
*.pyc

# Runtime state, if EDGE_STATE_DIR ever points at the working tree
*.log
*.pid

# Local env. .env.example is tracked and holds every key.
.env
.env.*
!.env.example

# Model weights
*.gguf
backend/models/*
!backend/models/.gitkeep

# Compiled objects, if cmake is ever run in-source under llama-src
*.o
*.a
*.d
*.so
*.so.*

# Core dumps. Workers are killed on purpose when testing crash recovery.
core
core.*
vgcore.*

extras/

# Merge leftovers
*.orig
*.rej

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp
